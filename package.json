{
    "name": "qqbot-template",
    "version": "1.0.0",
    "private": false,
    "description": "QQ 官方机器人通用模板（零依赖，官方协议实现）——填两个 key 就能有自己的 QQ 角色",
    "type": "module",
    "engines": {
        "node": ">=22.4.0"
    },
    "scripts": {
        "start": "node src/main.js",
        "check": "node src/main.js --check",
        "mock": "node src/main.js --mock",
        "smoke": "node src/main.js --mock --once",
        "test": "node --test --test-isolation=none test/persona.test.js test/unit.test.js test/memory.test.js test/owner-memory.test.js test/pending-actions.test.js test/group-proactive.test.js test/vision.test.js test/chat.test.js test/trigger.test.js test/resolve-at.test.js test/reminder.test.js test/files.test.js test/e2e.test.js test/reconnect.test.js test/reconnect-policy.test.js test/tts.test.js test/tts-rvc.test.js test/format.test.js test/imagegen.test.js test/stickers.test.js test/stickers-library.test.js test/sticker-ingest.test.js test/harassment.test.js test/scene-label.test.js test/remote.test.js test/remote-agent.test.js test/brain-switch.test.js test/sing.test.js test/sing-group.test.js test/voice-context.test.js test/voice-group.test.js",
        "test:unit": "node --test --test-isolation=none test/unit.test.js",
        "test:memory": "node --test --test-isolation=none test/memory.test.js",
        "test:vision": "node --test --test-isolation=none test/vision.test.js",
        "test:chat": "node --test --test-isolation=none test/chat.test.js",
        "test:trigger": "node --test --test-isolation=none test/trigger.test.js",
        "test:files": "node --test --test-isolation=none test/files.test.js",
        "test:e2e": "node --test --test-isolation=none test/e2e.test.js",
        "test:reconnect": "node --test --test-isolation=none test/reconnect.test.js test/reconnect-policy.test.js",
        "check:vision": "node scripts/check-vision.mjs",
        "check:chat": "node scripts/check-chat.mjs",
        "check:trigger": "node scripts/check-trigger.mjs",
        "check:files": "node scripts/check-files.mjs",
        "bundle": "node scripts/bundle.mjs",
        "build:exe": "node scripts/bundle.mjs && node scripts/build-exe.mjs",
        "test:reminder": "node --test --test-isolation=none test/reminder.test.js",
        "test:remote": "node --test --test-isolation=none test/remote.test.js test/remote-agent.test.js",
        "test:brain": "node --test --test-isolation=none test/brain-switch.test.js",
        "check:remote-agent": "node scripts/check-remote-agent.mjs",
        "test:tts": "node --test --test-isolation=none test/tts.test.js",
        "test:sing": "node --test --test-isolation=none test/sing.test.js test/sing-group.test.js",
        "test:owner-memory": "node --test --test-isolation=none test/owner-memory.test.js",
        "test:pending": "node --test --test-isolation=none test/pending-actions.test.js",
        "test:group-proactive": "node --test --test-isolation=none test/group-proactive.test.js",
        "check:memory-share": "node scripts/check-memory-share.mjs",
        "check:pending": "node scripts/check-pending.mjs",
        "voice:test": "node scripts/voice-selftest.mjs",
        "check:voice-rvc": "node scripts/check-voice-rvc.mjs",
        "check:voice-engine": "node scripts/check-voice-engine.mjs",
        "check:reminder": "node scripts/check-reminder.mjs",
        "check:brain": "node scripts/check-brain-switch.mjs",
        "check:label": "node scripts/check-label.mjs",
        "check:song": "node scripts/check-song.mjs",
        "check:sticker": "node scripts/check-sticker-send.mjs",
        "check:group-voice": "node scripts/check-group-voice.mjs"
    },
    "dependencies": {},
    "optionalDependencies": {
        "ws": "^8.18.0"
    }
}
