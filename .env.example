# 复制为 .env 后填写。切勿把 .env 提交进版本库。
# ---------------------------------------------------------------

# 机器人凭证（QQ 开放平台 → 机器人管理端）
QQ_APP_ID=
QQ_APP_SECRET=

# ---------------------------------------------------------------
# 人格（这是这个模板最该改的两行）
# ---------------------------------------------------------------
# 机器人自称（人格文件里的名字优先；这里是没有明确自我介绍时的兜底）
BOT_NAME=春禾
# 人格模块：
#   chunhe   = 示例人格（春禾，默认）
#   default  = 通用助手人格（小助手，中性、开箱即用）
#   ./my-bot.js = 你自己的文件（相对项目根目录）
# 写自己的角色：复制 src/persona/default.js 改成你的，再用 PERSONA 指过去。
PERSONA=chunhe

# 沙箱环境联调时设为 true
QQ_SANDBOX=true

# 访问控制：强烈建议至少设置用户白名单，否则任何加到机器人的用户都能消耗你的模型额度。
# 多个 ID 用逗号分隔。留空 = 不限制（仅调试）。
QQ_ALLOW_FROM=
QQ_DENY_FROM=
QQ_ALLOW_GROUPS=

# 限流与上下文
QQ_RATE_LIMIT_PER_MINUTE=12
QQ_HISTORY_TURNS=8
# 主人统一会话单独放大：私聊里下的指令在群里更久不被挤掉（20 轮 ≈ 40 条）
QQ_OWNER_HISTORY_TURNS=20
# 字符预算：超出就从最旧整轮丢；中文按 1 token/字保守估算，3000 字 ≈ 3000 token 上限
QQ_OWNER_HISTORY_MAX_CHARS=3000
QQ_DEDUPE_WINDOW=2000

# 群聊触发方式：mention（只回 @，默认） / wake（喊名字也回） / all（全部回，扰民）
# ⚠️ wake 要生效，群主必须开启"接收全量消息"，否则普通发言不会推给机器人。
QQ_GROUP_TRIGGER=mention
# 唤名 = 群里喊哪个名字算叫到你。
# ⚠️ 它和人格是两件事，不会自动跟着换：用了 PERSONA=default（小助手）时，
#    这里要同步改成 QQ_WAKE_NAMES=小助手（或你自己角色的名字），否则喊新名字不响应。
QQ_WAKE_NAMES=春禾
# 未触发的群消息是否记入上下文（不调用模型、不花钱），被叫到时能接上话题
QQ_GROUP_WATCH=true
QQ_GROUP_WATCH_LIMIT=10

# 定时提醒：让春禾能在"X 分钟后"主动说一句话（属于主动消息，占平台配额）
QQ_REMINDERS=true
QQ_REMINDER_FILE=data/reminders.json
QQ_REMINDER_DAILY_LIMIT=10
QQ_REMINDER_MIN_DELAY_MS=5000
QQ_REMINDER_MAX_DELAY_MS=604800000
QQ_REMINDER_TICK_MS=15000

# 多段回复：像真人一样分几口气说，而不是甩一条长文
QQ_MULTI_MESSAGE=true
QQ_MULTI_MESSAGE_MAX=3
QQ_MULTI_MESSAGE_CHARS=120
QQ_MULTI_MESSAGE_MIN=60
QQ_MULTI_MESSAGE_MIN_GAP=350
QQ_MULTI_MESSAGE_MAX_GAP=1400

# 共享话题库：让单聊聊过的事能在群里续上。
# ⚠️ 只有列在 QQ_ADMIN_USERS 里的人，其私聊话题才会进入共享库——
#    这是隐私边界，绝不能把别人的私聊内容漏给群里。
# 主人的身份：私聊与群聊共享同一份记忆（其他人仍严格隔离）。
# 默认 QQ_ADMIN_USERS 里的人就是主人；如果真机上群内 member_openid 与私聊
# user_openid 不同，把群内那个 openid 补到 QQ_OWNER_USERS（逗号分隔）。
QQ_ADMIN_USERS=
QQ_OWNER_USERS=
# 主人长期记忆（偏好/称呼/指令），跨场景生效、持久化
QQ_OWNER_MEMORY_FILE=data/owner-memory.json
QQ_OWNER_MEMORY_MAX=50
QQ_TOPIC_FILE=data/topics.json
QQ_TOPIC_CONTEXT_LIMIT=5

# 跨场景待办：主人在私聊说「待会到群里做 X」→ 独立存起来，到群里执行。
# 它**不占** QQ_HISTORY_TURNS 配额（这是「私聊指令群聊不执行」的真正解法）。
QQ_PENDING_ACTIONS=true
QQ_PENDING_FILE=data/pending-actions.json
# 投递方式：proactive=创建后立刻主动发到群里（默认，不用主人再开口）；
#           deferred = 旧行为，等主人到群里说话时随回复执行。
QQ_PENDING_DELIVERY=proactive
# 有效期（小时）：隔天再执行一句「卖个萌」会很突兀，默认 24h
QQ_PENDING_TTL_HOURS=24
QQ_PENDING_MAX=50

# 群注册表：春禾要知道「我在哪些群、每个群大概多大」。
# 成员数接口（/v2/groups/{gid}/members）很多应用没权限（真机 11253），
# 拿不到时按「见过几位发言人」估算——这是下限，不是真实人数。
QQ_GROUPS_FILE=data/groups.json
# API 真人数的大群阈值（>=10 人 = 大群）
QQ_GROUP_LARGE_THRESHOLD=10
# observed 下限的大群阈值（observed 系统性低估，默认 5）
QQ_GROUP_OBSERVED_LARGE_THRESHOLD=5
# 主人只说「群里」时怎么选：active=最活跃的群（默认）/ small=小群优先
QQ_GROUP_DEFAULT_PICK=active

# 群主动消息配额账本（发之前查、发完记，重启不清零）
QQ_PROACTIVE_QUOTA_FILE=data/proactive-quota.json
# 平台限制（官方文档）：群聊主动消息 单群 20 条/分钟、1000 条/天
QQ_GROUP_PROACTIVE_DAILY_LIMIT=1000
QQ_GROUP_PROACTIVE_MINUTE_LIMIT=20
# 功能自限：私聊指令转群主动消息，每天最多几条（防刷屏）
QQ_PENDING_PROACTIVE_DAILY_LIMIT=20
# 到自限多少比例时在回执里提醒
QQ_PROACTIVE_WARN_RATIO=0.8

# 主人问曲库时最多注入多少歌名（控制 token；不是每轮都注入）
QQ_SONG_LIBRARY_LIMIT=60

# 主动消息（"自己找话说"）。默认关闭：
#   平台对主动消息有每日配额，用户也可在资料卡关闭推送，需要你确认后再开。
QQ_PROACTIVE=false
QQ_PROACTIVE_IDLE_MINUTES=90
QQ_PROACTIVE_DAILY_LIMIT=3
QQ_PROACTIVE_QUIET_HOURS=23-8
QQ_PROACTIVE_CHECK_INTERVAL_MS=60000
QQ_PROACTIVE_STATE_FILE=data/proactive.json

# 可选：OpenAI 兼容模型。不填则使用本地规则回复（无需任何 key 也能跑通链路）。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=60000

# 视觉：设为 true 后，图片会先下载再以 base64 内联送给模型（直链会被模型服务端拒）。
# ⚠️ 只有多模态模型才能开；纯文本模型开了会对着图片凭空编造。
MODEL_VISION=false
MODEL_VISION_MAX_BYTES=5242880
MODEL_VISION_TIMEOUT_MS=15000

# AI 明示标识方式：
#   none   = 不加（聊天更自然；靠正文自报家门，但简短回复会没有 AI 提示）
#   prefix = 【AI】你好（默认，最稳妥）
#   suffix = 你好 【AI】
# 合规提醒：QQ 运营规范禁止"引导用户不披露真实身份"，请自行权衡。
AI_LABEL_STYLE=prefix
AI_LABEL=【AI】

# 日志与状态
LOG_LEVEL=info
QQ_SESSION_FILE=data/session.json

# 排查「群里 @ 了为什么没反应」时打开：会打印网关收到的每一个原始事件。
# 平时保持 false，避免日志过于嘈杂。
QQ_DEBUG_RAW_EVENTS=false

# ============================================================
# 语音回复（TTS）
# ============================================================
# off    = 不发语音（默认；语音完全是可选能力，关掉不影响任何文字功能）
# mirror = 收到语音才用语音回（对称，且属于被动回复，不吃主动消息配额）★推荐
# always = 私聊里所有回复都用语音
QQ_VOICE_REPLY=off

# 音色。默认 zh-CN-XiaoyiNeural —— 年轻活泼的少女音（官方标签 Lively）。
# 想更温柔可换 zh-CN-XiaoxiaoNeural（标签 Warm）。
TTS_VOICE=zh-CN-XiaoyiNeural

# 跑合成助手的 Python 解释器（需要 edge-tts + silk-python + miniaudio）。
# 留空则用 PATH 上的 python。建议指向一个专用 venv，例如：
#   TTS_PYTHON=C:\path\to\qqbot-chunhe\.voice-venv\Scripts\python.exe
TTS_PYTHON=

# 助手脚本路径；留空使用仓库内 tools/tts_silk.py
TTS_SCRIPT=

# 语速与音调微调（edge-tts 语法：+10% / -5% / +0Hz）
TTS_RATE=+0%
TTS_PITCH=+0Hz

# 单条语音最多念多少字（QQ 语音有时长上限，超长会被平台拒）
TTS_MAX_CHARS=120

# 合成超时（毫秒）；超时会降级为文字，不会卡住回复
TTS_TIMEOUT_MS=20000

# 群聊语音策略：
#   false     = 群里一律不发语音（默认，最稳）
#   on-demand = 只在群友/主人明确说「用语音说…」时才发语音，普通消息仍打字
#   true      = 与私聊一致（mirror 收到语音回语音 / always 全语音）
TTS_ALLOW_GROUP=false

# ============================================================
# 远程控制（第四档能力：在这台电脑上执行命令，**仅私聊**，默认关闭）
# ============================================================
# ⚠️ 打开之前请确认三件事：① 只有私聊可用；② QQ_ADMIN_USERS 已填对；
#    ③ 口令短语只告诉信得过的人。这是"任意命令执行"，不是玩具。
REMOTE_ENABLED=false

# 口令短语（整句匹配，不区分大小写、折叠空白）。说它解锁，默认 10 分钟后自动上锁。
REMOTE_UNLOCK_PHRASE=vibe coding
REMOTE_LOCK_PHRASE=stop coding

# 解锁有效期 / 单条命令超时 / 回显给模型或主人的输出上限（字）
REMOTE_TTL_MS=600000
REMOTE_TIMEOUT_MS=30000
REMOTE_MAX_OUTPUT=1500

# 用哪种 shell 执行：powershell 或 cmd（Windows）
REMOTE_SHELL=powershell

# 危险命令（关机/格式化/递归删除等）的确认码有效期
REMOTE_CONFIRM_TTL_MS=60000

# ---- 自然语言 agent（解锁后说人话，自己翻译成命令、执行、看结果、再下一步）----
# REMOTE_AGENT_MAX_STEPS：一次任务最多连续执行几步（刹车，防止自己绕圈烧 token）
REMOTE_AGENT_MAX_STEPS=5
# 想临时关掉自然语言模式（只保留 /执行 这类明确指令）就设 false
REMOTE_AGENT_ENABLED=true

# 双引擎切换：'春禾启动主脑' 时调用的脚本（留空 = 自动查找 switch-brain.ps1）
QQ_BRAIN_SWITCH_SCRIPT=
# 跑切换脚本用的 PowerShell（留空 = 系统自带 5.1）
QQ_BRAIN_SWITCH_POWERSHELL=

# ============================================================
# 画图（DeepSeek 工具调用 → 火山方舟 Seedream → QQ 富媒体图片）
# ============================================================
# 留空 = 功能自动关闭：**不会**给模型注册生图工具，行为与没有这个功能时完全一致。
# 没有 key 却注册工具是最糟的做法——模型会每轮都调、每次都失败，既烧 token 又画不出来。
ARK_API_KEY=

# 方舟地址（一般不用改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 生图模型。⚠️ 用之前请先用 GET /api/v3/models 核对，方舟的模型名换得很勤：
#   实测存在且已开通：doubao-seedream-5-0-pro-260628（flash 版存在但需另行开通）
#   文档里常见的 doubao-seedream-5-0-lite-260128 **在方舟侧根本不存在**（会 404）
# 若报 "has not activated the model ..."，说明名字是对的，只是账号还没在方舟控制台开通。
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_IMAGE_SIZE=1024x1024
# 角色参考图（本地路径，用于锁住春禾的长相）；留空 = 纯文生图
ARK_IMAGE_REFERENCE=

# 总开关（有 key 时默认开启）
IMAGE_GEN_ENABLED=true
# 生图超时（毫秒）；超时降级为文字说明，不会卡住回复
IMAGE_GEN_TIMEOUT_MS=90000
# 一次回复里最多允许几轮工具调用（刹车，防止模型反复调工具绕圈）
IMAGE_GEN_MAX_ROUNDS=3
# 图片大小上限（字节）。QQ 富媒体有上限，超了会拒收，所以本地先拦
IMAGE_GEN_MAX_BYTES=4194304

# 角色锚定：不可妥协的人设特征，每次生图都会拼在最前面。留空 = 不锚定。
IMAGE_GEN_CHARACTER_LOCK=
# ============================================================
# 表情包（自定义贴图）
# ============================================================
# QQ 没有独立的「表情包」消息类型，所以走的就是图片那条路（file_type=1）。
# 素材放 assets/stickers/，文件名即名字；目录为空时不注册工具。
STICKER_ENABLED=true
# 素材目录（留空 = assets/stickers）
STICKER_DIR=
# 单张上限（字节）；超了平台会拒收，所以本地先拦
STICKER_MAX_BYTES=2097152